# ───────────────────────────────────────────────
# ShopSage AI - Backend Environment Variables
# ───────────────────────────────────────────────

# Google AI Studio API Key (gemini.google.com/app -> API Keys)
GOOGLE_API_KEY=your_google_api_key_here

# Supabase Credentials (app.supabase.com -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# App Settings
APP_ENV=development
LOG_LEVEL=INFO
